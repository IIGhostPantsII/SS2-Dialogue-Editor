{
  "name": "Stupid Simulator 2 Dialogue Editor",
  "short_name": "SS2 Dialogue",
  "description": "Readable, editable dialogue JSON for Stupid Simulator 2.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2a1457",
